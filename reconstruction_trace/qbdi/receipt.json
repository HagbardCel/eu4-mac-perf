  "interception": {
    "result": "supported",
    "reason": null,
    "mechanism": "5-byte jmp rel32 at tr0_chase entry to intercept_stub.S; the stub saves the natural caller's GPRs and FXSAVE state, switches to a private host stack, removes the hook, and qbdi_run executes from the entry to the caller's return address on the caller's own stack; the hook is reinstalled and the caller resumes from QBDI's exit state. This is QBDI's documented hook-then-run pattern without Frida.",
    "checks": {
      "natural_call_entered_qbdi": true,
      "caller_resumed_with_expected_result": true,
      "hook_removed_after_call": true,
      "same_instruction_path_as_vm_call": true
    },
    "limits": [
      "The hook is removed while QBDI runs, so a concurrent call from another thread runs natively and untraced.",
      "A recursive call into the hooked function during the run is traced by the same VM, not intercepted again.",
      "Unwinding or longjmp through the stub is unsupported."
    ],
    "trace_completeness": "complete"
  },
