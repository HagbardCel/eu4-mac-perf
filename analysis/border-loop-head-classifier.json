{
  "schema_version": 2,
  "api": "classify_batchable_prefix",
  "ibo_bind_topology_default": "ONE_BIND",
  "barrier_mask_bits": {
    "SKIP": 1,
    "UNSUPPORTED_MODE": 2,
    "COLOR_TRANSITION": 4,
    "VBO_TRANSITION": 8,
    "IBO_TRANSITION": 16,
    "OTHER_SIDE_EFFECT": 32
  },
  "termination_kind": ["BARRIER", "WALK_END", "SCAN_CAP", "INVALID"],
