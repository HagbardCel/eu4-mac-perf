    "skip_record": "visibility_test_before_deref",
    "triangle_count_zero": "boundary_OTHER_SIDE_EFFECT",
    "deferred_attrib_upload_pending": "fall_through_at_hook",
    "scan_cap": "not_barrier_telemetry"
  },
  "telemetry_phase_a": [
    "eligible_runs",
    "eligible_draws",
    "eligible_draw_calls_eliminable",
    "barrier_skip",
    "barrier_mode",
    "barrier_color",
    "barrier_vbo",
    "barrier_ibo",
    "barrier_other",
    "run_length_histogram",
    "max_run_length"
  ],
  "telemetry_phase_b_additional": [
    "actual_multidraw_calls",
    "actual_draw_calls_eliminated"
  ],
  "invariant_b_phase_local": "actual_draw_calls_eliminated <= eligible_draw_calls_eliminable",
  "barrier_counter_semantics": "count_set_bits_per_event_not_mutually_exclusive"
}
