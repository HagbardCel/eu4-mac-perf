{
  "schema": "eu4-dsh-campaign/v1",
  "campaign_id": "dsh-offline-smoke",
  "source_campaign": "campaigns/automation-smoke/campaign.json",
  "checker_retry": {
    "mode": "stateful",
    "confirmation_rounds": 1
  },
  "candidate": {
    "mode": "seed",
    "policy": {
      "allowed_paths": [
        "marker.txt",
        "progress.md"
      ]
    },
    "workspace_base": "infra",
    "workspace": ".local/dsh/dsh-offline-smoke/workspace"
  },
  "goal": {
    "max_rounds": 6,
    "require_checker_pass": true,
    "require_independent_review": false
  },
  "limits": {
    "max_validations": 8,
    "validation_timeout_seconds": 60,
    "wall_clock_seconds": 1800,
    "max_review_attempts": 2
  },
  "live_capture": {
    "enabled": false
  }
}
