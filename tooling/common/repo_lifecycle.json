    {"match": "benchmark/**", "lifecycle": "ACTIVE", "reason": "Operational profiler and CLI entry points", "owner": "benchmark"},
    {"match": "analysis/README.md", "lifecycle": "ACTIVE", "reason": "Area navigation index for the legacy analysis tree", "owner": "analysis"},
    {"match": "analysis/*.md", "lifecycle": "RETIRED_EXPERIMENT", "reason": "Historical analysis writeups", "owner": "analysis"},
    {"match": "analysis/**/*.md", "lifecycle": "UNKNOWN", "reason": "Nested analysis document; classification uncertain, not assumed generated", "owner": "analysis"},
    {"match": "analysis/renderer-corpus/**", "lifecycle": "GENERATED_DERIVED", "reason": "Generated renderer corpus", "owner": "analysis"},
