{
  "policy_version": "1",
  "notes": "Curated, versioned classification layer. Rules are first-match in order; overrides win over rules. Patterns are path-aware globs: * and ? stay within a single path segment, ** spans segments. A classification is never archival authorization: archive_eligible requires an explicit entry in approved_for_archive AND no dependency conflict. Keep this file outside the analyzed source revision (it may not exist at that revision); its SHA-256 is recorded in docs/repo-audit-context.json.",
  "rules": [
    {"match": "results/**", "lifecycle": "FROZEN_VERIFIER", "reason": "Preserved run evidence under results/; per-run seal verification is asserted separately via evidence_capsules", "owner": "evidence"},
    {"match": "analysis/evidence/**", "lifecycle": "FROZEN_VERIFIER", "reason": "Generated analysis evidence records; preservation required", "owner": "analysis"},
    {"match": "analysis/tools/**", "lifecycle": "ACTIVE", "reason": "Analysis tooling still invoked by tests and forensic workflows", "owner": "analysis"},
    {"match": "reverse_engineering/**", "lifecycle": "ACTIVE", "reason": "Static RE tooling; load-bearing for RE0 selection", "owner": "reverse-engineering"},
    {"match": "oracle/**", "lifecycle": "ACTIVE", "reason": "Oracle capture/validation package; active program code", "owner": "oracle"},
    {"match": "tooling/**", "lifecycle": "ACTIVE", "reason": "Shared guards and audit tooling", "owner": "tooling"},
    {"match": "tests/**", "lifecycle": "ACTIVE", "reason": "Portable test suite", "owner": "tests"},
    {"match": "benchmark/*border*", "lifecycle": "RETIRED_EXPERIMENT", "reason": "Border multi-draw track wound down (NO-GO)", "owner": "benchmark"},
    {"match": "analysis/*border*", "lifecycle": "RETIRED_EXPERIMENT", "reason": "Border multi-draw investigation, superseded", "owner": "analysis"},
    {"match": "benchmark/eu4_state_cache.*", "lifecycle": "RETIRED_EXPERIMENT", "reason": "State-cache experiment: failed to engage", "owner": "benchmark"},
    {"match": "benchmark/eu4_sampler_uniform.*", "lifecycle": "RETIRED_EXPERIMENT", "reason": "Sampler-uniform experiment: no measurable signal", "owner": "benchmark"},
    {"match": "benchmark/frame_model_observer_bias.py", "lifecycle": "RETIRED_EXPERIMENT", "reason": "Observer-bias calibration; historical", "owner": "benchmark"},
    {"match": "docs/wp*.md", "lifecycle": "RETIRED_EXPERIMENT", "reason": "WP-series memos superseded by docs/status.md and the canonical strategy", "owner": "docs"},
    {"match": "docs/observer-bias-calibration*.md", "lifecycle": "RETIRED_EXPERIMENT", "reason": "Historical calibration memo", "owner": "docs"},
    {"match": "docs/profiler-overhead-diagnosis-*.md", "lifecycle": "RETIRED_EXPERIMENT", "reason": "Historical diagnosis memo", "owner": "docs"},
