    {"match": "analysis/**", "lifecycle": "UNKNOWN", "reason": "Unrecognized analysis file; not assumed regenerable", "owner": "analysis"},
    {"match": "docs/**", "lifecycle": "ACTIVE", "reason": "Documentation", "owner": "docs"},
    {"match": "experiments/**", "lifecycle": "ACTIVE", "reason": "Isolated hypothesis placeholder", "owner": "experiments"},
