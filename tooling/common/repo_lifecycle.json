{
  "policy_version": "1",
  "notes": "Curated, versioned classification layer. Rules are first-match in order; overrides win over rules. A classification is never archival authorization: archive_eligible requires an explicit entry in approved_for_archive AND no dependency conflict. Keep this file outside the analyzed source revision (it may not exist at that revision); its SHA-256 is recorded in docs/repo-audit-context.json.",
  "rules": [
    {"match": "results/**", "lifecycle": "FROZEN_VERIFIER", "reason": "Sealed run evidence verified by the eu4_frame_model evidence gate", "owner": "evidence"},
    {"match": "analysis/evidence/**", "lifecycle": "FROZEN_VERIFIER", "reason": "Generated analysis evidence records; preservation required", "owner": "analysis"},
    {"match": "analysis/tools/**", "lifecycle": "ACTIVE", "reason": "Analysis tooling still invoked by tests and forensic workflows", "owner": "analysis"},
    {"match": "reverse_engineering/**", "lifecycle": "ACTIVE", "reason": "Static RE tooling; load-bearing for RE0 selection", "owner": "reverse-engineering"},
    {"match": "tooling/**", "lifecycle": "ACTIVE", "reason": "Shared guards and audit tooling", "owner": "tooling"},
    {"match": "tests/**", "lifecycle": "ACTIVE", "reason": "Portable test suite", "owner": "tests"},
    {"match": "benchmark/*border*", "lifecycle": "RETIRED_EXPERIMENT", "reason": "Border multi-draw track wound down (NO-GO)", "owner": "benchmark"},
    {"match": "analysis/*border*", "lifecycle": "RETIRED_EXPERIMENT", "reason": "Border multi-draw investigation, superseded", "owner": "analysis"},
    {"match": "benchmark/eu4_state_cache.*", "lifecycle": "RETIRED_EXPERIMENT", "reason": "State-cache experiment: failed to engage", "owner": "benchmark"},
    {"match": "benchmark/eu4_sampler_uniform.*", "lifecycle": "RETIRED_EXPERIMENT", "reason": "Sampler-uniform experiment: no measurable signal", "owner": "benchmark"},
    {"match": "benchmark/frame_model_observer_bias.py", "lifecycle": "RETIRED_EXPERIMENT", "reason": "Observer-bias calibration; historical", "owner": "benchmark"},
    {"match": "docs/wp*.md", "lifecycle": "RETIRED_EXPERIMENT", "reason": "WP-series memos superseded by docs/status.md and the canonical strategy", "owner": "docs"},
    {"match": "docs/observer-bias-calibration*.md", "lifecycle": "RETIRED_EXPERIMENT", "reason": "Historical calibration memo", "owner": "docs"},
    {"match": "docs/profiler-overhead-diagnosis-*.md", "lifecycle": "RETIRED_EXPERIMENT", "reason": "Historical diagnosis memo", "owner": "docs"},
    {"match": "docs/phase-c-outcome-memo.md", "lifecycle": "RETIRED_EXPERIMENT", "reason": "Historical phase-outcome memo", "owner": "docs"},
    {"match": "docs/stage-2-*.md", "lifecycle": "RETIRED_EXPERIMENT", "reason": "Historical stage-2 memo", "owner": "docs"},
    {"match": "docs/tier1-*.md", "lifecycle": "RETIRED_EXPERIMENT", "reason": "Historical tier-1 memo", "owner": "docs"},
    {"match": "benchmark/**", "lifecycle": "ACTIVE", "reason": "Operational profiler and CLI entry points", "owner": "benchmark"},
    {"match": "analysis/*.md", "lifecycle": "RETIRED_EXPERIMENT", "reason": "Historical analysis writeups", "owner": "analysis"},
    {"match": "analysis/**", "lifecycle": "GENERATED_DERIVED", "reason": "Generated analysis data/evidence", "owner": "analysis"},
    {"match": "docs/**", "lifecycle": "ACTIVE", "reason": "Documentation", "owner": "docs"},
    {"match": "experiments/**", "lifecycle": "ACTIVE", "reason": "Isolated hypothesis placeholder", "owner": "experiments"},
    {"match": "measurements/**", "lifecycle": "ACTIVE", "reason": "Measurement registry placeholder", "owner": "measurements"},
    {"match": "patches/**", "lifecycle": "ACTIVE", "reason": "Version-pinned modifications placeholder", "owner": "patches"},
    {"match": "fixtures/**", "lifecycle": "ACTIVE", "reason": "Local fixtures/references placeholder", "owner": "fixtures"},
    {"match": ".github/**", "lifecycle": "ACTIVE", "reason": "CI workflow", "owner": "ci"},
    {"match": ".githooks/**", "lifecycle": "ACTIVE", "reason": "Git hooks", "owner": "ci"},
    {"match": "README.md", "lifecycle": "ACTIVE", "reason": "Repository entry point", "owner": "docs"},
    {"match": ".gitignore", "lifecycle": "ACTIVE", "reason": "Repository hygiene", "owner": "tooling"},
    {"match": "plan.md", "lifecycle": "UNKNOWN", "reason": "Root planning doc; ownership/currency unresolved", "owner": "unassigned"},
    {"match": "EU IV on Apple Silicon*", "lifecycle": "UNKNOWN", "reason": "Original plan document; ownership unresolved", "owner": "unassigned"}
  ],
  "overrides": [],
  "approved_for_archive": []
}
