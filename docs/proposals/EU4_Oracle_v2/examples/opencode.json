{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "default_agent": "eu4-reconstructor",
  "subagent_depth": 0,
  "permission": {
    "*": "deny",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "edit": {
      "*": "deny",
      "src/**": "allow"
    },
    "bash": "deny",
    "task": "deny",
    "external_directory": "deny",
    "webfetch": "deny",
    "websearch": "deny",
    "oracle_*": "allow"
  }
}
